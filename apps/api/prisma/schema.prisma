generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  reports Report[]
  contentBlocks ContentBlock[]
  role UserRole @default(CONSULTANT)
  groups Group[]
  memberships GroupMember[]
}

model ContentBlock {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title String
  category String
  content Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reportBlocks ReportBlock[]
}

model Report {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title String
  status ReportStatus @default(DRAFT)
  intro Json?
  document Json?
  documentStyle Json?
  blocks ReportBlock[]
  deliveries ReportDelivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportBlock {
  id String @id @default(cuid())
  reportId String
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  contentBlockId String?
  contentBlock ContentBlock? @relation(fields: [contentBlockId], references: [id], onDelete: SetNull)
  title String
  content Json
  notes String?
  position Int
  @@unique([reportId, position])
}

model ReportDelivery {
  id String @id @default(cuid())
  reportId String
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recipients Json
  sentAt DateTime @default(now())
  status String @default("QUEUED")
}

enum ReportStatus {
  DRAFT
  READY
  SENT
}


enum UserRole {
  CONSULTANT
  MEMBER
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum MemberRole {
  MEMBER
}

model Group {
  id String @id @default(cuid())
  consultantId String
  consultant User @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  name String
  clientName String?
  status GroupStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  archivedAt DateTime?
  members GroupMember[]
  @@index([consultantId, status])
}

model GroupMember {
  id String @id @default(cuid())
  groupId String
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  email String
  displayName String
  role MemberRole @default(MEMBER)
  status MemberStatus @default(INVITED)
  invitedAt DateTime @default(now())
  joinedAt DateTime?
  removedAt DateTime?
  invitations InviteToken[]
  @@unique([groupId, email])
  @@index([userId, status])
}

model InviteToken {
  id String @id @default(cuid())
  groupMemberId String
  groupMember GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([groupMemberId])
}
